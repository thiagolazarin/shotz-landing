{%- comment -%} SHOTZ · landing de produto (hero → CTA final, compra, carrinho lateral, diálogos) {%- endcomment -%}


  <!-- 2 · HERO -->
  <section class="hero" id="inicio" aria-labelledby="hero-title" data-hero>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Shot de proteína pronto para beber</p>
        <h1 id="hero-title" class="hero__title">Proteína que acompanha o seu <em>ritmo.</em></h1>
        <p class="hero__lead">23g de proteína em um shot de 100ml. Prático, leve e pronto para beber. Sem shaker, sem complicação.</p>
      </div>

      <div class="hero__art">
{%- liquid
  assign hero = section.settings.hero_image
  assign hero_alt = hero.alt | default: 'Garrafas de SHOTZ com frutas tropicais, gelo e luz natural'
-%}
{%- if hero != blank -%}
        <div class="hero-art">
          {{ hero | image_url: width: 1400 | image_tag: widths: '480, 640, 800, 1000, 1200, 1400', sizes: '(min-width: 1024px) 48vw, 92vw', class: 'hero-art__photo', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
        </div>
{%- else -%}
        <div class="hero-art" role="img" aria-label="Garrafas de SHOTZ Frutas Tropicais e Cranberry com metades de limão e cranberries, sob luz de sol">
          <div class="hero-art__blob" aria-hidden="true">
            <svg viewBox="0 0 600 600" preserveAspectRatio="none"><path fill="currentColor" d="M302 22c96 4 190 46 238 128 47 80 44 186 6 270-38 85-112 150-201 166-90 16-196-18-257-90C27 424 5 324 21 236 37 148 101 72 180 38c38-16 80-18 122-16Z"/></svg>
          </div>
          <div class="hero-art__sun" aria-hidden="true"></div>
          <div class="hero-art__shadow" aria-hidden="true"></div>
          <img class="hero-art__fruit hero-art__fruit--lemon-b" src="{{ 'shotz-slice-lemon-b.webp' | asset_url }}" alt="" width="240" height="240" decoding="async">
          <img class="hero-art__fruit hero-art__fruit--lemon-c" src="{{ 'shotz-slice-lemon-c.webp' | asset_url }}" alt="" width="240" height="240" decoding="async">
          <img class="hero-art__bottle hero-art__bottle--back" src="{{ 'shotz-bottle-cranberry-360.webp' | asset_url }}" srcset="{{ 'shotz-bottle-cranberry-180.webp' | asset_url }} 180w, {{ 'shotz-bottle-cranberry-360.webp' | asset_url }} 360w" sizes="(min-width: 1024px) 140px, 22vw" alt="" width="360" height="870" decoding="async">
          <img class="hero-art__bottle hero-art__bottle--main" src="{{ 'shotz-bottle-tropical-360.webp' | asset_url }}" srcset="{{ 'shotz-bottle-tropical-180.webp' | asset_url }} 180w, {{ 'shotz-bottle-tropical-360.webp' | asset_url }} 360w" sizes="(min-width: 1024px) 170px, 27vw" alt="" width="360" height="866" decoding="async" fetchpriority="high">
          <img class="hero-art__fruit hero-art__fruit--lemon-a" src="{{ 'shotz-slice-lemon-a.webp' | asset_url }}" alt="" width="300" height="300" decoding="async">
          <img class="hero-art__fruit hero-art__fruit--half" src="{{ 'shotz-berry-half-a.webp' | asset_url }}" alt="" width="200" height="200" decoding="async">
          <img class="hero-art__fruit hero-art__fruit--berry-a" src="{{ 'shotz-berry-a.webp' | asset_url }}" alt="" width="180" height="180" decoding="async">
          <img class="hero-art__fruit hero-art__fruit--berry-b" src="{{ 'shotz-berry-b.webp' | asset_url }}" alt="" width="180" height="180" decoding="async">
          <p class="hero-art__chip hero-art__chip--a" aria-hidden="true"><span class="hero-art__chip-dot"><svg class="icon" aria-hidden="true"><use href="#i-sparkles"/></svg></span><span><b>23g</b>de proteína</span></p>
          <p class="hero-art__chip hero-art__chip--b" aria-hidden="true"><span class="hero-art__chip-dot"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg></span><span><b>Zero</b>lactose</span></p>
        </div>
{%- endif -%}
      </div>

      <div class="hero__buy">
        <ul class="hero__stats" aria-label="Por unidade">
          <li><strong>23<small>g</small></strong><span>de proteína</span></li>
          <li><strong>95</strong><span>kcal</span></li>
          <li><strong>100<small>ml</small></strong><span>por shot</span></li>
        </ul>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href="#comprar" data-track-cta="hero">Experimente SHOTZ <svg class="icon icon--arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          <a class="btn btn--ghost btn--lg" href="#produto">Conheça o produto</a>
        </div>
        <ul class="trust-row" aria-label="Condições">
          <li><svg class="icon" aria-hidden="true"><use href="#i-truck"/></svg>Frete grátis acima de R$ 129,90</li>
          <li><svg class="icon" aria-hidden="true"><use href="#i-lock"/></svg>Checkout seguro</li>
          <li><svg class="icon" aria-hidden="true"><use href="#i-repeat"/></svg>Assinatura com 15% off</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 3 · O QUE É -->
  <section class="section" id="produto" aria-labelledby="what-title">
    <div class="container">
      <header class="section-head section-head--split reveal">
        <div style="display:grid;gap:18px">
          <p class="eyebrow">O produto</p>
          <h2 id="what-title" class="h2">Esqueça o shake. Conheça uma nova forma de consumir proteína.</h2>
        </div>
        <p class="lead">Uma dose de proteína em um formato compacto, refrescante e pronto para beber. SHOTZ foi criado para facilitar sua rotina, onde quer que você esteja.</p>
      </header>

      <ul class="feature-cards">
        <li class="feature-card reveal">
          <div class="feature-card__visual">
            <span class="feature-card__icon" aria-hidden="true"><svg class="icon"><use href="#i-sparkles"/></svg></span>
            <ol class="steps-compare" aria-label="Com o shake: medir, misturar e lavar. Com SHOTZ: abrir e beber.">
              <li><s>Medir o pó</s></li>
              <li><s>Misturar e agitar</s></li>
              <li><s>Lavar a coqueteleira</s></li>
              <li class="is-shotz">Abrir e beber</li>
            </ol>
          </div>
          <h3>Pronto para beber</h3>
          <p>Sem preparo, sem coqueteleira e sem complicação.</p>
        </li>
        <li class="feature-card reveal">
          <div class="feature-card__visual">
            <span class="feature-card__icon" aria-hidden="true"><svg class="icon"><use href="#i-backpack"/></svg></span>
            <div class="size-visual" aria-hidden="true">
              <img class="size-visual__bottle" src="{{ 'shotz-bottle-tropical-180.webp' | asset_url }}" srcset="{{ 'shotz-bottle-tropical-180.webp' | asset_url }} 180w, {{ 'shotz-bottle-tropical-360.webp' | asset_url }} 360w" sizes="54px" alt="" width="360" height="866" decoding="async" loading="lazy">
              <div class="size-visual__ruler"><span style="bottom:0"></span><span style="bottom:20%"></span><span style="bottom:40%"></span><span style="bottom:60%"></span><span style="bottom:80%"></span><span style="bottom:100%"></span></div>
              <p class="size-visual__label">100<small>ml</small></p>
            </div>
          </div>
          <h3>Cabe na sua rotina</h3>
          <p>Uma embalagem compacta de 100ml, fácil de levar para qualquer lugar.</p>
        </li>
        <li class="feature-card reveal">
          <div class="feature-card__visual">
            <span class="feature-card__icon" aria-hidden="true"><svg class="icon"><use href="#i-dna"/></svg></span>
            <div class="ring-visual" aria-hidden="true">
              <svg viewBox="0 0 120 120"><circle class="ring-visual__track" cx="60" cy="60" r="52" fill="none" stroke-width="10"/><circle class="ring-visual__value" cx="60" cy="60" r="52" fill="none" stroke-width="10" pathLength="100"/></svg>
              <p class="ring-visual__text">23g<small>por shot</small></p>
            </div>
          </div>
          <h3>Proteína em cada shot</h3>
          <p>23g de proteína em uma única unidade.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- 4 · BENEFÍCIOS -->
  <section class="section benefits" id="beneficios" aria-labelledby="benefits-title">
    <div class="container">
      <header class="section-head section-head--center reveal">
        <p class="eyebrow">Por unidade de 100 ml</p>
        <h2 id="benefits-title" class="h2">Pequeno no tamanho. <em>Completo</em> na praticidade.</h2>
      </header>
      <div class="benefits__layout">
        <ul class="benefit-list benefit-list--left">
          <li class="benefit reveal">
            <p class="benefit__value">23<small>g</small></p>
            <h3 class="benefit__label">Proteína</h3>
            <p class="benefit__desc">Uma dose concentrada de proteína em cada unidade de 100 ml.</p>
          </li>
          <li class="benefit reveal">
            <p class="benefit__value">95<small>kcal</small></p>
            <h3 class="benefit__label">Calorias</h3>
            <p class="benefit__desc">Uma opção leve para incluir no dia a dia.</p>
          </li>
          <li class="benefit reveal">
            <p class="benefit__value">0,8<small>g</small></p>
            <h3 class="benefit__label">Carboidratos</h3>
            <p class="benefit__desc">Menos de 1 g de carboidratos por unidade.</p>
          </li>
        </ul>
        <div class="benefits__visual" aria-hidden="true">
          <div class="benefits__sun"></div>
          <div class="benefits__ring"></div>
          <img class="benefits__bottle" src="{{ 'shotz-bottle-tropical-360.webp' | asset_url }}" srcset="{{ 'shotz-bottle-tropical-180.webp' | asset_url }} 180w, {{ 'shotz-bottle-tropical-360.webp' | asset_url }} 360w" sizes="(min-width: 1024px) 168px, 104px" alt="" width="360" height="866" decoding="async" loading="lazy">
        </div>
        <ul class="benefit-list benefit-list--right">
          <li class="benefit reveal">
            <p class="benefit__value benefit__value--word">Zero</p>
            <h3 class="benefit__label">Lactose</h3>
            <p class="benefit__desc">Fórmula sem lactose.</p>
          </li>
          <li class="benefit reveal">
            <p class="benefit__value benefit__value--word">Zero</p>
            <h3 class="benefit__label">Gordura</h3>
            <p class="benefit__desc">Sem gordura na composição.</p>
          </li>
          <li class="benefit reveal">
            <p class="benefit__value benefit__value--word">Zero</p>
            <h3 class="benefit__label">Adição de açúcares</h3>
            <p class="benefit__desc">Sem açúcares adicionados. O sabor adocicado vem do edulcorante sucralose.</p>
          </li>
        </ul>
      </div>
      <p class="footnote">Valores por unidade (100 ml), conforme informações do fabricante.</p>
    </div>
  </section>

  <!-- 5 · MOMENTOS -->
  <section class="section" id="momentos" aria-labelledby="moments-title">
    <div class="container">
      <header class="section-head section-head--split reveal">
        <div style="display:grid;gap:18px">
          <p class="eyebrow">No seu dia</p>
          <h2 id="moments-title" class="h2">Seu ritmo. Seu momento. Seu <em>SHOTZ.</em></h2>
        </div>
        <p class="lead">Uma unidade de 100 ml cabe na bolsa, na mochila ou na gaveta do escritório.</p>
      </header>
    </div>
    <div class="moments__scroller" tabindex="0" role="region" aria-label="Momentos para SHOTZ. Role para o lado para ver todos.">
      <ul class="moments__list">
        <li class="moment moment--work">
          <figure>
            <div class="moment__scene">
              <span class="moment__tag"><svg class="icon" aria-hidden="true"><use href="#i-briefcase"/></svg>Trabalho</span>
              {%- liquid
  assign img = section.settings.moment_work_image
  assign img_alt = img.alt | default: 'Pessoa no trabalho com SHOTZ'
-%}
{%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1024px) 24vw, 78vw', loading: 'lazy', alt: img_alt }}{%- else -%}<div data-art="scene-work" role="img" aria-label="Mesa de trabalho com notebook, caneca de café e uma garrafa de SHOTZ"></div>{%- endif -%}
            </div>
            <figcaption><h3>No trabalho</h3><p>Praticidade entre reuniões e compromissos.</p></figcaption>
          </figure>
        </li>
        <li class="moment moment--gym">
          <figure>
            <div class="moment__scene">
              <span class="moment__tag"><svg class="icon" aria-hidden="true"><use href="#i-dumbbell"/></svg>Academia</span>
              {%- liquid
  assign img = section.settings.moment_gym_image
  assign img_alt = img.alt | default: 'Pessoa na academia com SHOTZ'
-%}
{%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1024px) 24vw, 78vw', loading: 'lazy', alt: img_alt }}{%- else -%}<div data-art="scene-gym" role="img" aria-label="Tapete de yoga enrolado, halteres leves, toalha e uma garrafa de SHOTZ"></div>{%- endif -%}
            </div>
            <figcaption><h3>Na academia</h3><p>Uma opção prática para complementar a alimentação.</p></figcaption>
          </figure>
        </li>
        <li class="moment moment--travel">
          <figure>
            <div class="moment__scene">
              <span class="moment__tag"><svg class="icon" aria-hidden="true"><use href="#i-plane"/></svg>Viagem</span>
              {%- liquid
  assign img = section.settings.moment_travel_image
  assign img_alt = img.alt | default: 'Pessoa em viagem com SHOTZ'
-%}
{%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1024px) 24vw, 78vw', loading: 'lazy', alt: img_alt }}{%- else -%}<div data-art="scene-travel" role="img" aria-label="Mala de viagem, óculos de sol, cartão de embarque e uma garrafa de SHOTZ"></div>{%- endif -%}
            </div>
            <figcaption><h3>Em viagens</h3><p>Proteína que ocupa pouco espaço.</p></figcaption>
          </figure>
        </li>
        <li class="moment moment--daily">
          <figure>
            <div class="moment__scene">
              <span class="moment__tag"><svg class="icon" aria-hidden="true"><use href="#i-sun"/></svg>Rotina</span>
              {%- liquid
  assign img = section.settings.moment_daily_image
  assign img_alt = img.alt | default: 'SHOTZ na rotina do dia a dia'
-%}
{%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1024px) 24vw, 78vw', loading: 'lazy', alt: img_alt }}{%- else -%}<div data-art="scene-daily" role="img" aria-label="Bancada iluminada pelo sol com fruteira, ecobag e uma garrafa de SHOTZ"></div>{%- endif -%}
            </div>
            <figcaption><h3>Na rotina</h3><p>Uma alternativa para momentos em que você busca praticidade.</p></figcaption>
          </figure>
        </li>
      </ul>
    </div>
    <p class="moments__hint" aria-hidden="true"><svg class="icon icon--sm"><use href="#i-arrow"/></svg>Deslize para ver os quatro momentos</p>
  </section>

  <!-- 6 · SABORES + COMPRA -->
  <section class="section shop" id="comprar" aria-labelledby="shop-title" data-shop>
    <div class="container">
      <header class="section-head section-head--center reveal">
        <p class="eyebrow">Sabores</p>
        <h2 id="shop-title" class="h2">Dois sabores. A mesma <em>praticidade.</em></h2>
      </header>

      <div class="shop__grid">
        <div class="flavor-stage" data-flavor-stage data-flavor="tropical">
          <div class="flavor-stage__art" aria-hidden="true">
            <img class="flavor-stage__photo" data-for="tropical" src="{{ 'shotz-flat-tropical-1200.webp' | asset_url }}" srcset="{{ 'shotz-flat-tropical-720.webp' | asset_url }} 720w, {{ 'shotz-flat-tropical-1200.webp' | asset_url }} 1200w" sizes="(min-width: 1024px) 50vw, 92vw" alt="" width="1200" height="1200" loading="lazy" decoding="async">
            <img class="flavor-stage__photo" data-for="cranberry" src="{{ 'shotz-flat-cranberry-1200.webp' | asset_url }}" srcset="{{ 'shotz-flat-cranberry-720.webp' | asset_url }} 720w, {{ 'shotz-flat-cranberry-1200.webp' | asset_url }} 1200w" sizes="(min-width: 1024px) 50vw, 92vw" alt="" width="1200" height="1200" loading="lazy" decoding="async">
          </div>
          <div class="flavor-stage__info" aria-live="polite">
            <p class="flavor-stage__kicker">Sabor</p>
            <h3 class="flavor-stage__name" data-bind="flavor-name">Frutas Tropicais</h3>
            <p class="flavor-stage__desc" data-bind="flavor-desc">Frutado, solar e refrescante, inspirado nas frutas amarelas tropicais. Textura leve, no estilo suco.</p>
            <ul class="chips" data-bind="flavor-notes"><li>Frutado</li><li>Refrescante</li><li>Textura leve</li></ul>
            <p class="flavor-stage__price">Caixa com 6 unidades: <strong data-bind="flavor-from">R$ 100,00</strong></p>
            <div class="flavor-switch" role="group" aria-label="Ver sabor">
              <button type="button" data-flavor-switch="tropical" aria-pressed="true">Frutas Tropicais</button>
              <button type="button" data-flavor-switch="cranberry" aria-pressed="false">Cranberry</button>
            </div>
          </div>
        </div>

        {%- form 'product', product, class: 'buy-box', data-buy-box: '', novalidate: 'novalidate', aria-labelledby: 'buy-title' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="selling_plan" value="" disabled>
          <div class="buy-box__head">
            <h3 id="buy-title" class="buy-box__title">SHOTZ<span>Suplemento alimentar líquido</span><span>23 g de proteína · 100 ml</span></h3>
            <a class="rating-link" href="#avaliacoes"><svg class="icon" aria-hidden="true"><use href="#i-star"/></svg><span data-bind="review-count-label">21 avaliações</span></a>
          </div>

          <fieldset class="opt-group">
            <legend>Sabor <span data-bind="flavor-name">Frutas Tropicais</span></legend>
            <div class="flavor-options">
              <label class="choice flavor-opt">
                <input type="radio" name="flavor" value="tropical" checked>
                <span class="choice__card"><span class="flavor-opt__img" aria-hidden="true"><img src="{{ 'shotz-bottle-tropical-96.webp' | asset_url }}" alt="" width="96" height="231" loading="lazy" decoding="async"></span><span class="flavor-opt__name">Frutas Tropicais</span></span>
              </label>
              <label class="choice flavor-opt">
                <input type="radio" name="flavor" value="cranberry">
                <span class="choice__card"><span class="flavor-opt__img" aria-hidden="true"><img src="{{ 'shotz-bottle-cranberry-96.webp' | asset_url }}" alt="" width="96" height="232" loading="lazy" decoding="async"></span><span class="flavor-opt__name">Cranberry</span></span>
              </label>
            </div>
            <p class="opt-note" data-bind="kit-note">Starter Kit (2 Cranberry + 2 Frutas Tropicais): esgotado no momento.</p>
          </fieldset>

          <fieldset class="opt-group">
            <legend>Quantidade</legend>
            <div class="qty-options" data-qty-options>
              <!-- Opções geradas a partir das variantes reais (ver shotz.js > renderQuantity) -->
            </div>
          </fieldset>

          <fieldset class="opt-group" data-plan-group>
            <legend>Como você quer receber</legend>
            <div class="plan-options">
              <label class="choice plan-opt">
                <input type="radio" name="plan" value="once" checked>
                <span class="choice__card">
                  <span class="radio-dot" aria-hidden="true"></span>
                  <span class="plan-opt__title">Compra única</span>
                  <span class="plan-opt__meta">Pague uma vez, sem recorrência</span>
                  <span class="plan-opt__price" data-plan-price="once">R$ 180,00</span>
                </span>
              </label>
              <label class="choice plan-opt plan-opt--sub">
                <input type="radio" name="plan" value="sub">
                <span class="choice__card">
                  <span class="radio-dot" aria-hidden="true"></span>
                  <span class="plan-opt__title">Assinatura mensal <span class="badge badge--citrus" data-bind="sub-badge">15% OFF</span></span>
                  <span class="plan-opt__meta">Entrega todo mês</span>
                  <span class="plan-opt__price" data-plan-price="sub">R$ 153,00</span>
                </span>
              </label>
            </div>
          </fieldset>

          <dl class="summary" aria-live="polite">
            <div class="summary__row summary__row--total"><dt>Total</dt><dd><s data-sum="compare">R$ 200,00</s><span data-sum="total">R$ 180,00</span></dd></div>
            <div class="summary__row"><dt>Preço por shot</dt><dd data-sum="unit">R$ 15,00</dd></div>
            <div class="summary__row"><dt>Desconto aplicado</dt><dd class="summary__save" data-sum="save">R$ 20,00 (10%)</dd></div>
            <div class="summary__row"><dt>Frete</dt><dd data-sum="ship"><span class="summary__ship-free"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Grátis</span></dd></div>
          </dl>
          <p class="save-detail" data-sum="detail">10% de desconto no kit com 2 caixas.</p>

          <button type="submit" class="btn btn--primary btn--xl btn--block add-btn" data-add-btn>
            <span data-add-label>Adicionar<span class="add-btn__long"> ao carrinho</span></span><span class="add-btn__price" data-sum="btn-price">R$ 180,00</span>
          </button>

          <ul class="buy-box__trust">
            <li><svg class="icon" aria-hidden="true"><use href="#i-lock"/></svg>Checkout seguro da loja (Shopify)</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-truck"/></svg>Frete grátis acima de R$ 129,90</li>
          </ul>
        {%- endform -%}
      </div>
    </div>
  </section>

  <!-- 7 · COMPARAÇÃO -->
  <section class="section" id="comparacao" aria-labelledby="compare-title">
    <div class="container">
      <header class="section-head section-head--split reveal">
        <div style="display:grid;gap:18px">
          <p class="eyebrow">Comparação</p>
          <h2 id="compare-title" class="h2">Uma nova experiência em proteína.</h2>
        </div>
        <p class="lead">O que muda quando a proteína chega pronta para beber, lado a lado com o whey em pó.</p>
      </header>
      <div class="compare__wrap reveal">
        <table class="compare-table">
          <caption class="sr-only">Comparação entre SHOTZ e whey protein em pó tradicional</caption>
          <thead>
            <tr><th scope="col"><span class="sr-only">Característica</span></th><th scope="col" class="is-shotz"><span class="logo__word">SHOTZ</span></th><th scope="col">Whey em pó tradicional</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Fonte de proteína</th><td class="is-shotz" data-label="SHOTZ">Colágeno hidrolisado com mix de aminoácidos</td><td data-label="Whey em pó">Proteína do soro do leite</td></tr>
            <tr><th scope="row">Quantidade de proteína</th><td class="is-shotz" data-label="SHOTZ"><span class="mark" aria-hidden="true"><svg class="icon"><use href="#i-check"/></svg></span>23 g por unidade de 100 ml</td><td data-label="Whey em pó">Varia conforme a marca e o tamanho da dose indicada no rótulo</td></tr>
